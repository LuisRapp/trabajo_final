# Copiar a .env.production y completar. El archivo final no se versiona.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

APP_NAME=Rennova
APP_ENV=production
APP_DEBUG=false

# Obligatoria. Generar una con: php artisan key:generate --show
# Si queda vacia, el entrypoint genera una en el primer arranque y avisa por
# stderr: hay que copiarla aca, porque el .env del contenedor se pierde en el
# proximo redeploy.
APP_KEY=

APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=rennova
DB_USERNAME=rennova
DB_PASSWORD=definir-clave-segura

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_LEVEL=error
